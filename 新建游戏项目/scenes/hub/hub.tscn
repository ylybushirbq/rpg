mouse_filter = 2

[node name="CamBox" type="VBoxContainer" parent="UiLayer/Ui/Margin/HBox"]
layout_mode = 2
size_flags_vertical = 0
theme_override_constants/separation = 8

[node name="CameraButton" type="Button" parent="UiLayer/Ui/Margin/HBox/CamBox"]
